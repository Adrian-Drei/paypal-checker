NUXT_PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=
NUXT_PAYPAL_SANDBOX_CLIENT_SECRET=
NUXT_PUBLIC_PAYPAL_LIVE_CLIENT_ID=
NUXT_PAYPAL_LIVE_CLIENT_SECRET=
NUXT_PAYPAL_LIVE_TEST_ENABLED=false

# Server-only tester gate. A unique, random password of at least 24 characters is recommended.
NUXT_PAYPAL_TESTER_USERNAME=
NUXT_PAYPAL_TESTER_PASSWORD=

# Persistent Upstash Redis (server-only). Use a durable database with eviction disabled.
# false pauses payment endpoints; it does not bypass persistent duplicate protection.
NUXT_PAYPAL_REDIS_ENABLED=true
NUXT_PAYPAL_REDIS_REST_URL=
NUXT_PAYPAL_REDIS_REST_TOKEN=
# Keep stable across production instances/redeploys; isolate preview deployments.
NUXT_PAYPAL_REDIS_PREFIX=paypal-checker
